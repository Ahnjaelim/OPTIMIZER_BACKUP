<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wellconn.optimizer.mapper.AlgorithmMapper">
	
<select id="seletAll" parameterType="AlgorithmVO" resultType="AlgorithmVO">
	SELECT * from om_algorithm
</select>

<select id="selectAlgorithmType" parameterType="AlgorithmVO" resultType="AlgorithmVO">
SELECT * from om_algorithm
		WHERE algorithm_type = #{algorithm_type} 
</select>

</mapper>